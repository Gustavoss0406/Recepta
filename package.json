{
  "name": "recepta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 next dev",
    "build": "next build",
    "start": "NODE_USE_ENV_PROXY=1 next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "worker": "NODE_USE_ENV_PROXY=1 tsx --conditions=react-server --env-file-if-exists=.env.local src/server/jobs/worker.ts",
    "simular:twilio": "NODE_USE_ENV_PROXY=1 tsx --conditions=react-server --env-file-if-exists=.env.local scripts/simular-twilio.ts",
    "voice": "NODE_USE_ENV_PROXY=1 tsx --conditions=react-server --env-file-if-exists=.env.local src/voice-gateway/server.ts",
    "e2e": "playwright test",
    "local": "pglite-server --db=.data/pglite --port=5433 --max-connections=40 --include-database-url --run \"npm run local:apps\"",
    "local:apps": "tsx src/db/migrate.ts && concurrently -k -n site,voz,tarefas -c blue,magenta,gray \"next dev -p 3000\" \"tsx --conditions=react-server --env-file-if-exists=.env.local src/voice-gateway/server.ts\" \"tsx --conditions=react-server --env-file-if-exists=.env.local src/server/jobs/worker.ts\"",
    "nuvem": "tsx --env-file-if-exists=.env.local src/db/migrate.ts && concurrently -k -n site,voz,tarefas -c blue,magenta,gray \"next dev -p 3000\" \"tsx --conditions=react-server --env-file-if-exists=.env.local src/voice-gateway/server.ts\" \"tsx --conditions=react-server --env-file-if-exists=.env.local src/server/jobs/worker.ts\"",
    "build:servicos": "esbuild src/voice-gateway/server.ts src/server/jobs/worker.ts src/db/migrate.ts src/voz-e-worker.ts --bundle --platform=node --format=esm --target=node22 --packages=external --conditions=react-server --outdir=dist --out-extension:.js=.mjs && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/migrations",
    "start:unico": "node scripts/servidor-unico.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@aws-sdk/client-s3": "^3.1170.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "node-html-parser": "^9.0.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "simple-icons": "^15.22.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.181.2",
    "use-stick-to-bottom": "^1.1.6",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
