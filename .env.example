# Database (Postgres 15+)
# Banco: `npm run local` ignora esta linha (usa banco embutido). `npm run nuvem` usa o Supabase:
# Supabase › Project Settings › Database › Connection string › Session pooler (porta 5432)
DATABASE_URL=postgresql://postgres.yjrwsaxrlzkmwdnlxbxq:SUA-SENHA-DO-BANCO@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# Gravações no Supabase Storage (bucket privado "gravacoes", já criado)
# Supabase › Project Settings › API Keys › service_role (secret). Nunca use esta chave no navegador.
SUPABASE_URL=https://yjrwsaxrlzkmwdnlxbxq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Long random secret (signs voice-session tokens)
RECEPTA_SEGREDO=
RECEPTA_URL_PUBLICA=https://app.recepta.ai

# LLM (Claude). Without it the app runs a clearly labelled demonstration engine.
# LLM engine: "rotacao" (free providers in rotation, default), "anthropic" (Claude) or "demo" (scripted)
LLM_MOTOR=rotacao
LLM_PROVEDORES=nvidia,groq,ovh,openrouter
GROQ_API_KEY=
# Optional fixed order, comma-separated (defaults come from the PT-BR benchmark in scripts/bench-llm.ts)
GROQ_MODELOS=
OPENROUTER_API_KEY=
OPENROUTER_MODELOS=
# Any other OpenAI-compatible server added to LLM_PROVEDORES, e.g. "local": LLM_LOCAL_URL / LLM_LOCAL_KEY / LLM_LOCAL_MODELOS
ANTHROPIC_API_KEY=

# Voice engine (server-side only). Voices are presented under our own catalog names.
TTS_API_KEY=
TTS_BASE_URL=https://api.elevenlabs.io
TTS_MODEL_PADRAO=eleven_v4_turbo
TTS_MODEL_ULTRA=eleven_v4
TTS_VOICE_MAP={"lia":"GDzHdQOi6jjf8zaXhCYD","rafael":"5p9IbzcK4R8rN1fpGdMF","bia":"RGymW84CSmfVugnA5tvA","caio":"xWdpADtEio43ew1zGxUQ","helena":"7iqXtOF3wl3pomwXFY7G","tomas":"Qrdut83w0Cr152Yb4Xn3"}

# Speech-to-text
DEEPGRAM_API_KEY=

# Voice gateway (npm run voice)
VOICE_PORT=3100
NEXT_PUBLIC_VOICE_URL=wss://voz.recepta.ai
VOICE_WS_PUBLICO=wss://voz.recepta.ai

# Telephony (optional until you have an account)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Payments (Asaas). Without a key, billing runs in sandbox-simulation mode.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Entrar com …" (opcional; sem estes, HubSpot/Pipedrive seguem por token). Veja README › Apps OAuth.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
RECEPTA_CHAVE_CRIPTO=

# Own voice engines (optional). Voices "clara"/"davi" use VoiceStudio (select the VoxCPM2 engine there:
# its default OmniVoice model is non-commercial); "marina"/"otavio" use Fish Audio drama-3 on a GPU server.
VOICESTUDIO_URL=
VOICESTUDIO_API_KEY=
VOICESTUDIO_VOICE_MAP=
DRAMA_URL=
DRAMA_API_KEY=
DRAMA_MODEL=fishaudio/drama-3
DRAMA_VOICE_MAP=

# Expressividade da voz ElevenLabs (menor estabilidade = mais entonação)
TTS_STABILITY=0.38
TTS_STYLE=0.3

# NVIDIA (build.nvidia.com, chave grátis, ~40 req/min). OVH AI Endpoints funciona sem chave (2 req/min por modelo).
NVIDIA_API_KEY=
OVH_API_KEY=

# Contas da equipe Recepta sem limite de uso (ids de organização, separados por vírgula)
RECEPTA_ORGS_ILIMITADAS=
